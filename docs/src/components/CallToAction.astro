---
// The end of the homepage: the install command again, and where to go next.
import { LinkButton } from '@astrojs/starlight/components';
import InstallCommand from './InstallCommand.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="cta not-content">
	<h2>Record your first view</h2>
	<p>Install the package, run the migrations, add a trait to your model and one middleware to its route. The quick start goes from there to a trending list in five steps.</p>
	<InstallCommand />
	<div class="actions">
		<LinkButton href={`${base}getting-started/quick-start/`} icon="right-arrow">Quick start</LinkButton>
		<LinkButton href={`${base}getting-started/introduction/`} variant="minimal">Read the introduction</LinkButton>
	</div>
</section>

<style>
	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		margin-top: 3rem;
		padding: clamp(1.5rem, 5vw, 3rem) 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 1rem;
		text-align: center;
		background:
			radial-gradient(80% 120% at 50% 0%, color-mix(in srgb, var(--sl-color-accent) 18%, transparent), transparent 70%);
	}

	h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-3xl);
		font-family: var(--ev-font-display);
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	p {
		margin: 0;
		max-width: 46ch;
		color: var(--sl-color-gray-2);
	}

	.cta :global(.install) {
		width: min(100%, 32rem);
		text-align: start;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem 2rem;
		align-items: center;
	}
</style>
