---
// The requirements of the current major on the homepage. The full table, with
// older versions, is on getting-started/requirements.
const requirements = [
	{ label: 'PHP', value: '8.5+' },
	{ label: 'Laravel', value: '13' },
	{ label: 'Databases', value: 'MySQL 8.0+, MariaDB, PostgreSQL, SQLite' },
];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="requirements not-content">
	<dl>
		{requirements.map((requirement) => (
			<div>
				<dt>{requirement.label}</dt>
				<dd>{requirement.value}</dd>
			</div>
		))}
	</dl>
	<p>
		<a href={`${base}getting-started/requirements/`}>Older versions</a>
		<span aria-hidden="true">·</span>
		<a href={`${base}project/upgrading/`}>Upgrading from 8.x</a>
	</p>
</div>

<style>
	dl {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 0.75rem;
		margin: 1rem 0 0;
	}

	dl > div {
		padding: 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
	}

	dl > div:last-child {
		grid-column: span 2;
	}

	@media (max-width: 40rem) {
		dl > div:last-child {
			grid-column: auto;
		}
	}

	dt {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	dd {
		margin: 0.25rem 0 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
	}

	p {
		display: flex;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
