---
// The "Start simple, scale when you need to" steps on the homepage, from the
// table on the introduction page. Each step is one config key away from the last.
const steps = [
	{ name: 'One insert per view', gain: 'Views count straight away, with nothing to set up.', href: 'getting-started/introduction/#start-simple-scale-when-you-need-to' },
	{ name: 'remember()', gain: 'Counts, series and rankings served from the cache.', href: 'counting/caching/' },
	{ name: 'Queued recording', gain: 'The insert moves out of the request.', href: 'recording/queueing/' },
	{ name: 'Redis buffer', gain: 'One Redis write per request, one insert per thousand views.', href: 'scaling/redis-buffer/' },
	{ name: 'Rollups', gain: 'History and cheap all-time counts after old views are deleted.', href: 'scaling/rollups/' },
	{ name: 'Partitions', gain: 'A whole month of views dropped at once.', href: 'scaling/partitioning/' },
];

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<ol class="ladder not-content">
	{steps.map((step, i) => (
		<li>
			<a href={base + step.href}>
				<span class="step">{i + 1}</span>
				<strong>{step.name}</strong>
				<span class="gain">{step.gain}</span>
			</a>
		</li>
	))}
</ol>

<style>
	/* A line runs through the numbered steps, across on wide screens and down on narrow ones. */
	.ladder {
		--dot: 1.75rem;
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.75rem;
	}

	li {
		position: relative;
	}

	li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(var(--dot) / 2);
		left: calc(var(--dot) + 0.25rem);
		right: calc(-0.75rem + 0.25rem);
		height: 2px;
		background: linear-gradient(to right, var(--sl-color-accent), var(--sl-color-gray-5));
	}

	.ladder a {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		height: 100%;
		color: var(--sl-color-white);
		text-decoration: none;
	}

	.step {
		display: inline-grid;
		place-items: center;
		width: var(--dot);
		height: var(--dot);
		margin-bottom: 0.35rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		border: 1px solid var(--sl-color-accent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		transition: background-color 0.15s, color 0.15s;
	}

	.ladder a:hover .step {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}

	.ladder a:hover strong {
		color: var(--sl-color-accent-high);
	}

	strong {
		font-size: var(--sl-text-base);
	}

	.gain {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
	}

	@media (max-width: 62rem) {
		.ladder {
			grid-template-columns: 100%;
			gap: 1.25rem;
		}

		.ladder a {
			display: grid;
			grid-template-columns: var(--dot) 1fr;
			column-gap: 1rem;
			row-gap: 0.2rem;
		}

		.step {
			grid-row: span 2;
			margin: 0;
		}

		li:not(:last-child)::after {
			top: calc(var(--dot) + 0.25rem);
			bottom: calc(-1.25rem + 0.25rem);
			left: calc(var(--dot) / 2 - 1px);
			right: auto;
			width: 2px;
			height: auto;
			background: linear-gradient(to bottom, var(--sl-color-accent), var(--sl-color-gray-5));
		}
	}
</style>
