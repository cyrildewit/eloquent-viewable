parameters:
	ignoreErrors:
		-
			message: '#^Called ''env'' outside of the config directory which returns null when the config is cached, use ''config''\.$#'
			identifier: larastan.noEnvCallsOutsideOfConfig
			count: 2
			path: config/eloquent-viewable.php

		-
			message: '#^Call to an undefined method CyrildeWit\\EloquentViewable\\Contracts\\Viewable\:\:getConnection\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/CacheKey.php

		-
			message: '#^Call to an undefined method CyrildeWit\\EloquentViewable\\Contracts\\Viewable\:\:getTable\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/CacheKey.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: src/CacheKey.php

		-
			message: '#^Method CyrildeWit\\EloquentViewable\\Contracts\\View\:\:scopeWithinPeriod\(\) has parameter \$query with generic class Illuminate\\Database\\Eloquent\\Builder but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: src/Contracts/View.php

		-
			message: '#^Method CyrildeWit\\EloquentViewable\\Contracts\\View\:\:viewable\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\MorphTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: src/Contracts/View.php

