			message: '#^Method CyrildeWit\\EloquentViewable\\Contracts\\Viewable\:\:scopeOrderByUniqueViews\(\) has parameter \$query with generic class Illuminate\\Database\\Eloquent\\Builder but does not specify its types\: TModel$#'
