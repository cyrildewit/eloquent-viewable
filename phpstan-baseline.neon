			message: '#^Method CyrildeWit\\EloquentViewable\\Contracts\\Viewable\:\:views\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\MorphMany does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
